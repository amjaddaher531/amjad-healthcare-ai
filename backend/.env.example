# AI Provider (Anthropic Claude by default; any OpenAI-compatible endpoint also supported)
ANTHROPIC_API_KEY=dummy_key_for_github
AI_MODEL=claude-sonnet-4-6

# Alternative OpenAI-compatible provider (optional)
OPENAI_API_BASE=
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./amjad_healthcare.db

# App
ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# OCR
TESSERACT_CMD=/usr/bin/tesseract
